{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered student or property owner account and private PII metadata for Roomie.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["student", "owner"]
        },
        "college": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 25
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "name", "email", "role", "city", "createdAt", "updatedAt"]
    },
    "OwnerPublicProfile": {
      "title": "OwnerPublicProfile",
      "description": "Publicly visible property owner display profile (contains no email or phone PII).",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "bio": {
          "type": "string",
          "maxLength": 300
        },
        "avatar": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "isDemo": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "city", "bio", "avatar", "isDemo", "updatedAt"]
    },
    "RoommateProfile": {
      "title": "RoommateProfile",
      "description": "Publicly matchable student lifestyle profile (contains no email or phone PII).",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "basics": { "type": "object" },
        "housing": { "type": "object" },
        "lifestyle": { "type": "object" },
        "importance": { "type": "object" },
        "dealBreakers": { "type": "array" },
        "isComplete": { "type": "boolean" },
        "isDemo": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "basics",
        "housing",
        "lifestyle",
        "importance",
        "dealBreakers",
        "isComplete",
        "isDemo",
        "updatedAt"
      ]
    },
    "Listing": {
      "title": "Listing",
      "description": "Property room/PG/flat/hostel listing created by a verified property owner.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "title": { "type": "string", "minLength": 5, "maxLength": 120 },
        "propertyType": { "type": "string", "enum": ["single_room", "shared_room", "pg", "flat", "hostel"] },
        "address": { "type": "object" },
        "rentPerMonth": { "type": "number" },
        "securityDeposit": { "type": "number" },
        "totalBeds": { "type": "number" },
        "availableBeds": { "type": "number" },
        "genderAllowed": { "type": "string", "enum": ["boys", "girls", "any"] },
        "furnished": { "type": "string", "enum": ["furnished", "semi", "unfurnished"] },
        "amenities": { "type": "array" },
        "houseRules": { "type": "object" },
        "nearbyLandmark": { "type": "string", "maxLength": 120 },
        "availableFrom": { "type": "string", "minLength": 4, "maxLength": 20 },
        "description": { "type": "string", "maxLength": 500 },
        "photoUrls": { "type": "array" },
        "authorizedConfirmed": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "paused", "rented"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "ownerId",
        "ownerName",
        "title",
        "propertyType",
        "address",
        "rentPerMonth",
        "securityDeposit",
        "totalBeds",
        "availableBeds",
        "genderAllowed",
        "furnished",
        "amenities",
        "houseRules",
        "nearbyLandmark",
        "availableFrom",
        "description",
        "photoUrls",
        "authorizedConfirmed",
        "status",
        "isDemo",
        "createdAt",
        "updatedAt"
      ]
    },
    "ConnectRequest": {
      "title": "ConnectRequest",
      "description": "Roommate connection request or student-to-owner listing enquiry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 260, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromUserId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "toUserId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined", "cancelled"] },
        "message": { "type": "string", "maxLength": 300 },
        "listingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "listingTitle": { "type": "string", "maxLength": 140 },
        "ownerPhone": { "type": "string", "maxLength": 25 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fromUserId", "toUserId", "status", "message", "createdAt", "updatedAt"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Conversation metadata between two accepted Roomie connections (student-student or student-owner).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 260, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participantIds": { "type": "array" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 260, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "listingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "listingTitle": { "type": "string", "maxLength": 140 },
        "lastMessage": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "participantIds", "requestId", "lastMessage", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a Roomie chat.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "minLength": 1, "maxLength": 260, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participantIds": { "type": "array" },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "timestamp": { "type": "string", "format": "date-time" },
        "readBy": { "type": "array" }
      },
      "required": ["chatId", "participantIds", "senderId", "text", "timestamp", "readBy"]
    },
    "SafetyReport": {
      "title": "SafetyReport",
      "description": "Safety report submitted against a student profile, owner, or listing.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "byUserId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetUserId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "listingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetType": { "type": "string", "enum": ["user", "listing", "owner"] },
        "reason": {
          "type": "string",
          "enum": [
            "fake_profile",
            "harassment",
            "inappropriate_content",
            "misleading_listing",
            "scam_deposit",
            "already_rented",
            "other"
          ]
        },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "byUserId", "targetUserId", "reason", "notes", "createdAt"]
    },
    "UserBlock": {
      "title": "UserBlock",
      "description": "Block relationship preventing visibility and interaction between two users.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 260, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "byUserId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetUserId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "byUserId", "targetUserId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "Owner-isolated student or property owner account records containing private PII (email, phone, role)."
    },
    "/ownerProfiles/{userId}": {
      "schema": { "$ref": "OwnerPublicProfile" },
      "description": "Public property owner display profiles (no email or phone PII)."
    },
    "/profiles/{userId}": {
      "schema": { "$ref": "RoommateProfile" },
      "description": "Student roommate lifestyle profiles (only students may write; readable by signed-in users when isComplete is true)."
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "Listing" },
      "description": "Property listings managed by property owners (only owners may write; active listings readable by signed-in users)."
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "ConnectRequest" },
      "description": "Roommate connection requests and student-owner listing enquiries."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "ChatThread" },
      "description": "Accepted Roomie conversation metadata."
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "ChatMessage" },
      "description": "Messages belonging to an accepted Roomie chat."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "SafetyReport" },
      "description": "Safety reports submitted against users or listings."
    },
    "/blocks/{blockId}": {
      "schema": { "$ref": "UserBlock" },
      "description": "User block records."
    }
  }
}
